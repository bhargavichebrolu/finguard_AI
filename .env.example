# FinGuard AI environment template. This file must only ever contain placeholders.
# Create a real .env with generated secrets: uv run --project backend python scripts/generate_env.py
# .env is ignored by Git. Use letters and digits only in passwords, because they go into URLs.

# --- Application ---
APP_ENV=development

# --- Local PostgreSQL container: superuser, used only to administer the database ---
POSTGRES_USER=finguard_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finguard
POSTGRES_HOST_PORT=5432

# --- The role the API connects as: not a superuser ---
APP_DB_USER=finguard_app
APP_DB_PASSWORD=change-me
TEST_DB_NAME=finguard_test

# --- Backend ---
# Used when running on this computer. Inside Docker Compose the URL is built from the values above.
# Use 127.0.0.1, not localhost: Compose publishes IPv4 only, and localhost tries IPv6 first.
DATABASE_URL=postgresql+psycopg://finguard_app:change-me@127.0.0.1:5432/finguard
TEST_DATABASE_URL=postgresql+psycopg://finguard_app:change-me@127.0.0.1:5432/finguard_test
# At least 32 characters. Production start-up refuses anything shorter.
SECRET_KEY=replace-with-a-long-random-value
CORS_ALLOWED_ORIGINS=http://localhost:5173
API_HOST_PORT=8000

# --- Frontend (Phase 4). Vite exposes only VITE_* values to browser code. ---
VITE_API_BASE_URL=http://localhost:8000
