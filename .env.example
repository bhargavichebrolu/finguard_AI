# FinGuard AI environment template. Copy to .env and fill in real values.
# .env is ignored by Git. This file must only ever contain placeholders.
# Phase 1 code reads none of these. They document the settings Phases 3 and 4 will use.

# --- Application ---
APP_ENV=development

# --- Backend (Phase 3) ---
DATABASE_URL=postgresql+psycopg://finguard:change-me@localhost:5432/finguard
SECRET_KEY=replace-with-a-long-random-value
CORS_ALLOWED_ORIGINS=http://localhost:5173
MODEL_ARTIFACT_DIR=../artifacts/models/current

# --- Local PostgreSQL container (Phase 3) ---
POSTGRES_USER=finguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finguard

# --- Frontend (Phase 4). Vite exposes only VITE_* values to browser code. ---
VITE_API_BASE_URL=http://localhost:8000
