# The frozen metadata files are verified by SHA-256 when the API starts, so their bytes must not
# change on checkout. Without this, Windows Git settings could rewrite their line endings.
artifacts/metadata/*.json -text

# Run inside Linux containers, so they must keep LF line endings.
docker/** text eol=lf
*.sh text eol=lf

# Compared byte for byte with what the API and generator produce, so line endings must not change.
frontend/openapi.json -text
frontend/src/types/api.generated.ts -text
